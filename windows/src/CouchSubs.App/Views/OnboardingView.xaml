<!-- Kurulum sihirbazı (yeni arayüz, tuval 00–08): üstte logo, ortada ilerleme noktaları (şimdiki adım amber hap), sağda
     "Sonra Ayarlarım"; içerik alanı yanlarda 120, üstte 24, altta 40; adım etiketi "ADIM 1 / 4", başlık, açıklama, adım;
     altta Geri (ikincil) ve tek ana düğme Devam. Kurulumda reklam yok. -->
<UserControl x:Class="CouchSubs.App.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:t="clr-namespace:CouchSubs.App.Theme"
             xmlns:local="clr-namespace:CouchSubs.App.Views">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="{DynamicResource size.titleBarHeight}" Margin="24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <c:CouchLogo />
                <TextBlock Text="CouchSubs" FontWeight="Bold" FontSize="15" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="Dots" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" />
            <Button x:Name="LaterButton" Grid.Column="2" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Content="{t:T 'I\'ll Set Up Later'}" Click="OnLater" />
        </Grid>

        <Grid Margin="120,24,120,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="Counter" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
            <ScrollViewer Grid.Row="1" Style="{StaticResource CardScroll}">
                <ContentControl x:Name="StepHost" Focusable="False" Margin="0,0,8,0" />
            </ScrollViewer>
            <DockPanel Grid.Row="2" Margin="0,32,0,0" LastChildFill="False">
                <Button x:Name="BackButton" Content="{t:T 'Back'}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Click="OnBack" />
                <Button x:Name="ContinueButton" Content="{t:T 'Continue'}" Style="{StaticResource WidePrimaryButton}" IsDefault="True"
                        IsEnabled="{Binding CanAdvance}" Click="OnContinue" />
                <!-- Her adımda: konsolu olmayan, uygulamayı örnek görüntülerle dener. -->
                <local:DemoModeButton DockPanel.Dock="Right" ButtonStyle="GhostButton" />
                <Button DockPanel.Dock="Right" Content="{t:T 'Reset setup'}" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                        Visibility="{Binding ConsoleKindLocked, Converter={StaticResource VisibleIf}}" Click="OnReset" />
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
